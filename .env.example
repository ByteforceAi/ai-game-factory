# ── 바이브코딩 아레나 환경변수 ──
# 전부 선택사항입니다. 하나도 없어도 정상 동작합니다 (API 키 불필요).

# 교사 패널(/instructor) PIN — 기관마다 다르게 설정 권장 (기본값: 0608)
# NEXT_PUBLIC_INSTRUCTOR_PIN=0608

# Vercel KV — 리더보드/공유/갤러리 영속 저장 (없으면 인메모리 폴백)
# Vercel Dashboard > Storage > KV 생성 시 자동 주입됩니다
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# 공유 링크/OG 태그 기준 도메인
# NEXT_PUBLIC_BASE_URL=https://your-domain.com
